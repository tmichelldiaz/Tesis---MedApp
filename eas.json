  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://medapp-backend-411936104651.us-central1.run.app",
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
