      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://medapp-backend-411936104651.us-central1.run.app",
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    }
  }
}
